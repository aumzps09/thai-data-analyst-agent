# Thai Data Analyst Agent — Environment Example
# Usage: cp .env.example .env
#
# IMPORTANT:
# - All API keys below are MOCK examples only.
# - Replace them with your real keys in .env.
# - Never commit the real .env file to Git.
#
# Required: DATABASE_URL
# Everything else is optional (offline-safe defaults).

# ============================================================
# Database
# ============================================================

# --- Database (required) ---
# Docker compose overrides this to:
# postgresql://analyst:analyst@postgres:5432/analyst
DATABASE_URL=postgresql://analyst:analyst@localhost:5432/analyst

# 1 = skip real DB (template SQL + mock rows)
# Used by pytest and evals.
# Default: 0
ANALYST_DB_OFFLINE=0


# ============================================================
# LLM Providers
# ============================================================

# --- Google Gemini ---
# Latest Flash model:
# gemini-3.8-flash
GEMINI_MODEL=gemini-3.8-flash

# Mock example key
GEMINI_API_KEY=AIzaSyExample_ReplaceWithYourGeminiApiKey


# --- OpenAI ---
# Latest flagship reasoning model:
# gpt-6-astra
OPENAI_MODEL=gpt-6-astra

# Mock example key
OPENAI_API_KEY=sk-proj-example_ReplaceWithYourOpenAIKey


# 1 = use LLM for SQL generation / routing
# 0 = template + rule-based behavior
SQL_LLM=0
ROUTER_LLM=0


# ============================================================
# Web Search Providers
# ============================================================

# --- Tavily ---
# Used for web search / research.
# Mock example key
TAVILY_API_KEY=tvly-example_ReplaceWithYourTavilyApiKey


# --- Brave Search ---
# Fallback search provider.
# Mock example key
BRAVE_API_KEY=BSA-example_ReplaceWithYourBraveApiKey


# ============================================================
# Docs Retrieval
# ============================================================

# --- Chroma ---
# Reuses Project 1 Chroma collection `docs`.
# Port 8001 is hardcoded in agent/nodes/doc_agent.py.
CHROMA_HOST=localhost


# ============================================================
# LangSmith
# ============================================================

# --- LangSmith tracing ---
LANGSMITH_TRACING=false

# Mock example key
LANGSMITH_API_KEY=lsv2_pt_example_ReplaceWithYourLangSmithApiKey

LANGSMITH_PROJECT=thai-data-analyst-agent


# ============================================================
# Redis
# ============================================================

# --- Redis (reserved, set by docker-compose) ---
# Currently unused by code.
# Kept for future session/cache.
REDIS_URL=redis://redis:6379/0